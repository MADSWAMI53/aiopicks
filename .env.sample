# Copy to .env and fill in your credentials
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
TRAKT_CLIENT_ID=replace-with-trakt-client-id
TRAKT_CLIENT_SECRET=replace-with-trakt-client-secret
TRAKT_ACCESS_TOKEN=replace-with-trakt-access-token
# Increase if you want deeper history exclusion (max 10000)
TRAKT_HISTORY_LIMIT=1000
# Cache compacted Trakt history (per-profile, per-type) to avoid re-downloading on every catalog refresh.
# Set to 0 to disable. 129600 = 36 hours.
TRAKT_HISTORY_CACHE_TTL_SECONDS=129600
# Optional: override the detected redirect URL if proxying through a custom domain
TRAKT_REDIRECT_URI=https://your-domain.example/api/trakt/callback
# Keep this in sync with the number of default catalog keys (currently 19)
CATALOG_COUNT=19
# Items per catalog (default 8)
CATALOG_ITEM_COUNT=50
COMBINE_FOR_YOU_CATALOGS=false
REFRESH_INTERVAL=43200
CACHE_TTL=1800
DATABASE_URL=sqlite+aiosqlite:///data/aiopicks.db